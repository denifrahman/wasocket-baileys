{
  "name": "wasocket-baileys",
  "version": "1.0.1",
  "description": "Library for managing WhatsApp multi-sessions with Baileys, supporting chat, file, and media handling.",
  "main": "dist/baileys.js",
  "types": "dist/baileys.d.ts",
  "exports": {
    ".": {
      "import": "./dist/baileys.js",
      "require": "./dist/baileys.js",
      "types": "./dist/baileys.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "ts-node ./example/index.ts",
    "start": "node dist/baileys.js",
    "start:example": "ts-node ./example/index.ts"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "typescript",
    "multi-session",
    "bot"
  ],
  "author": "denifrahman",
  "license": "ISC",
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^17.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "follow-redirects": "^1.15.6",
    "inquirer": "^12.9.6",
    "mime-types": "^2.1.35",
    "node-cache": "^5.1.2",
    "pino": "^8.14.1",
    "pino-pretty": "^10.2.0",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/follow-redirects": "^1.14.4",
    "@types/inquirer": "^9.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.11.19",
    "@types/node-cache": "^4.2.5",
    "@types/qr-image": "^3.2.9",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}